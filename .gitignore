# Environment & Secrets
.env
.env.*
!.env.example
docker-compose.env

settings.local.json

# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
out/
build/
*.tgz

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Coverage
coverage/
*.lcov

# Cache
.cache/
*.tsbuildinfo
.eslintcache

# Temporary files
tmp/
temp/

# ====================================
# Runtime / User Data (not in git)
# ====================================
# Config & templates in backend/data/ ARE tracked:
#   backend/data/agents/, backend/data/config/,
#   backend/data/skills/system/, backend/data/tools/

# Auth runtime data
backend/data/auth/sessions/*
!backend/data/auth/sessions/.gitkeep
backend/data/auth/users/*
!backend/data/auth/users/.gitkeep
backend/data/auth/groups/*
!backend/data/auth/groups/.gitkeep
backend/data/auth/oauth-states/*
!backend/data/auth/oauth-states/.gitkeep

# Chat data
backend/data/chats/*
!backend/data/chats/.gitkeep
backend/data/chat-uploads/*
!backend/data/chat-uploads/.gitkeep
backend/data/chat-folders.yaml
backend/data/conversations/*
!backend/data/conversations/.gitkeep

# Knowledge base (user documents)
backend/data/knowledge-base/*
!backend/data/knowledge-base/.gitkeep

# Generated content
backend/data/generated-images/*
!backend/data/generated-images/.gitkeep
backend/data/exports/*
!backend/data/exports/.gitkeep

# Task queue & results
backend/data/tasks/*
!backend/data/tasks/.gitkeep
backend/data/results/
backend/data/plans/

# Space runtime data
backend/data/spaces/*
!backend/data/spaces/.gitkeep

# Table data
backend/data/tables/*
!backend/data/tables/.gitkeep

# User memory
backend/data/memory/*
!backend/data/memory/.gitkeep

# Provider configs (may contain encrypted API keys)
# Ignore everything inside providers/ except the adacor default provider
backend/data/providers/*
!backend/data/providers/adacor/

# Connection connector credentials (verschlüsselte OAuth-Creds)
backend/data/connections/connectors/*/credentials.yaml
# Connection registry (runtime state)
backend/data/connections/registry.yaml

# User connection tokens (verschlüsselt, inkl. Legacy user_*-Dirs)
backend/data/connections/tokens/*
!backend/data/connections/tokens/.gitkeep
backend/data/connections/user_*/

# Usage tracking
backend/data/usage/*
!backend/data/usage/.gitkeep

# Audit logs
backend/data/audit/*
!backend/data/audit/.gitkeep

# Apps (user-created and runtime data)
backend/data/apps/

# Custom skills (user-created)
backend/data/skills/custom/

# Misc runtime files
backend/data/data/
backend/data/temp/
backend/data/notifications/
backend/data/*.html
backend/data/*.docx
backend/data/*.md
