# ====================================
# Runtime / User Data (not in git)
# ====================================
# Config & templates in backend/data/ ARE tracked:
#   backend/data/agents/, backend/data/apps/,
#   backend/data/config/, backend/data/skills/,
#   backend/data/tools/

# Auth runtime data
backend/data/auth/sessions/*
!backend/data/auth/sessions/.gitkeep
backend/data/auth/users/*
!backend/data/auth/users/.gitkeep
backend/data/auth/groups/*
backend/data/auth/oauth-states/*
!backend/data/auth/oauth-states/.gitkeep

# Chat data
backend/data/chats/
backend/data/chat-uploads/
backend/data/chat-folders.yaml
backend/data/conversations/

# Knowledge base (user documents)
backend/data/knowledge-base/

# Generated content
backend/data/generated-images/
backend/data/exports/

# Task queue & results
backend/data/tasks/
backend/data/results/
backend/data/plans/

# Project runtime data
backend/data/projects/

# Table data
backend/data/tables/

# User memory
backend/data/memory/

# Connection tokens (encrypted)
backend/data/connections/

# Usage tracking
backend/data/usage/

# Audit logs
backend/data/audit/

# App runtime data
backend/data/apps/vertragsmanagement/contracts/
backend/data/apps/projektmanagement/projektauftraege/

# Misc runtime files
backend/data/data/
backend/data/temp/
backend/data/notifications/
backend/data/*.html
backend/data/*.docx
backend/data/*.md
