# ====================================
# Runtime / User Data (not in git)
# ====================================
# Config & templates in backend/data/ ARE tracked:
#   backend/data/agents/, backend/data/config/,
#   backend/data/skills/system/, backend/data/tools/

# Auth runtime data
backend/data/auth/sessions/*
!backend/data/auth/sessions/.gitkeep
backend/data/auth/users/*
!backend/data/auth/users/.gitkeep
backend/data/auth/groups/*
!backend/data/auth/groups/.gitkeep
backend/data/auth/oauth-states/*
!backend/data/auth/oauth-states/.gitkeep

# Chat data
backend/data/chats/
backend/data/chat-uploads/
backend/data/chat-folders.yaml
backend/data/chats/chat-folders.yaml
backend/data/conversations/

# Knowledge base (user documents)
backend/data/knowledge-base/

# Generated content
backend/data/generated-images/
backend/data/exports/

# Task queue & results
backend/data/tasks/
backend/data/results/
backend/data/plans/

# Space runtime data
backend/data/spaces/

# Table data
backend/data/tables/

# User memory
backend/data/memory/

# Provider configs (contains encrypted API keys, created by migration)
backend/data/providers/

# Connection connector credentials (verschlüsselte OAuth-Creds)
backend/data/connections/connectors/*/credentials.yaml
# Connection registry (runtime state)
backend/data/connections/registry.yaml

# User connection tokens (verschlüsselt)
backend/data/connections/tokens/

# Usage tracking
backend/data/usage/

# Audit logs
backend/data/audit/

# Apps (user-created and runtime data)
backend/data/apps/

# Custom skills (user-created)
backend/data/skills/custom/

# Misc runtime files
backend/data/data/
backend/data/temp/
backend/data/notifications/
backend/data/*.html
backend/data/*.docx
backend/data/*.md
