# Agent Platform Backend Configuration

# Server
PORT=3001
API_BASE_URL=http://localhost:3001

# FRONTEND_URL — Optional. Nur nötig wenn Frontend auf einem anderen Origin läuft
# (d.h. ohne Vite Proxy / ohne K8s Ingress / ohne Reverse Proxy).
# Wenn nicht gesetzt, werden nur Same-Origin-Requests erlaubt (CORS).
# FRONTEND_URL=http://localhost:5173

# ============================================================
# LLM Provider Configuration
# ============================================================

# Adacor AI (Primary LLM)
ADACOR_AI_API_URL=https://api.adacor.ai/chat/privateai/v1
ADACOR_AI_API_KEY=your-adacor-api-key
ADACOR_AI_MODEL=mistral-3-24b-128k

# ============================================================
# Security & Encryption
# ============================================================

# Token Encryption (generate with: openssl rand -hex 32)
CONNECTION_ENCRYPTION_KEY=your-256-bit-hex-key-here

# ============================================================
# OAuth Integrations
# ============================================================

# Google OAuth (for Google Drive connection)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Confluence/Atlassian OAuth
# Create an OAuth 2.0 app at https://developer.atlassian.com/console/myapps/
CONFLUENCE_CLIENT_ID=your-atlassian-app-client-id
CONFLUENCE_CLIENT_SECRET=your-atlassian-app-client-secret

# ============================================================
# Optional: Image Generation
# ============================================================

# Google AI (Gemini Imagen) - for text-to-image and image-to-image
# Get API key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Nebius (Flux.1) - alternative image generation provider
NEBIUS_API_KEY=your-nebius-api-key

# ============================================================
# Optional: Web Search
# ============================================================

# Tavily API - for web search tool
# Get API key at https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key

# ============================================================
# Security Settings
# ============================================================

# SSRF Protection (Custom API Tools)
# Enable URLhaus malware domain checking (optional, makes external API call)
SSRF_CHECK_MALWARE=false
# Allow localhost in development (NOT recommended for production)
SSRF_ALLOW_LOCALHOST=false

# Proxy Configuration
# Set to true when running behind a reverse proxy (nginx, Cloudflare, etc.)
# This enables trusting X-Forwarded-For and X-Real-IP headers for client IP detection
# WARNING: Only enable this if you have a trusted proxy that sets these headers correctly
TRUST_PROXY=false

# ============================================================
# Platform-Locked Models (Provider-locked at deployment time)
# These models are used by platform features and cannot be
# changed by customers (admin or user)
# ============================================================

# Apps - Default model for chatbots and assistants
PLATFORM_APPS_PROVIDER_ID=adacor
PLATFORM_APPS_MODEL_ID=mistral-3-24b-128k

# Web Search - Model for search and research features
PLATFORM_SEARCH_PROVIDER_ID=adacor
PLATFORM_SEARCH_MODEL_ID=mistral-3-24b-128k

# Embeddings - Model for RAG and vector search
PLATFORM_EMBEDDINGS_PROVIDER_ID=adacor
PLATFORM_EMBEDDINGS_MODEL_ID=bge-m3

# Reranking (optional) - Model for search result reranking
# PLATFORM_RERANK_PROVIDER_ID=adacor
# PLATFORM_RERANK_MODEL_ID=bge-reranker-v2-m3

# ============================================================
# System Agent Models
# Fixed models for system agents (cannot be overridden by user)
# Leave empty to use system default from providers.yaml
# ============================================================

# Vision Agent - Must support vision capability
SYSTEM_VISION_PROVIDER_ID=adacor
SYSTEM_VISION_MODEL_ID=mistral-3-24b-128k

# Code Agent - For code generation and analysis
SYSTEM_CODE_PROVIDER_ID=adacor
SYSTEM_CODE_MODEL_ID=mistral-3-24b-128k

# Research Agent - For web research tasks
SYSTEM_RESEARCH_PROVIDER_ID=adacor
SYSTEM_RESEARCH_MODEL_ID=mistral-3-24b-128k

# Supervisor Agent - Must support tool_use for delegation
SYSTEM_SUPERVISOR_PROVIDER_ID=adacor
SYSTEM_SUPERVISOR_MODEL_ID=mistral-3-24b-128k
