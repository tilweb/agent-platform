# Agent Platform Backend Configuration
# ============================================================
# WICHTIG — Production-Key-Hygiene
# ============================================================
# Diese Datei ist EINE TEMPLATE — die echte `.env` ist gitignored und sollte
# pro Umgebung individuelle Schluessel tragen. NIEMALS Production-Keys lokal
# einsetzen (Screenshot-Risiko, Backup-Tool-Kopien, AI-Tool-Lesezugriff,
# malicious npm-Package-Lookup ueber process.env).
#
# Empfohlene Trennung:
# - Adacor/Nebius/Google/Tavily: separater Dev-API-Key mit niedrigem Quota
# - Postgres/S3: lokales Docker-Postgres + lokaler/Dev-Bucket — niemals
#   Production-DATABASE_URL oder Production-S3-Bucket auf Dev-Maschine
# - OAuth-Secrets: separate Dev-OAuth-App pro Provider
#
# Production-Secrets gehoeren in Scalingo-ENV / Vault / 1Password — nicht
# in Dateien auf dem Dev-Laptop.
# ============================================================

# Server
# ============================================================
# Lokal: Backend laeuft auf 3001, Vite-Dev-Server auf 5173.
# Beide URLs landen in der CORS-Allowlist (backend/src/index.ts) und in
# der CSP `connect-src`.
#
# Production (Scalingo): KEINE Ports angeben.
#   API_BASE_URL=https://workplace-demo.osc-fr1.scalingo.io
#   FRONTEND_URL=https://workplace-demo.osc-fr1.scalingo.io
# Scalingo's Router macht 443→Container-intern (3001 aus Dockerfile-EXPOSE).
# Der Browser sieht die App ueber 443 (HTTPS-Standard, ohne Port-Suffix).
# Falls die URL hier auf ":3001" enden wuerde, matcht der Browser-Origin-
# Header nicht und alle API-Calls werden CORS-rejected.
#
# Bei Same-Origin-Setup (Frontend via serveStatic vom Backend, ein
# Scalingo-Service) sind FRONTEND_URL und API_BASE_URL identisch.
#
# PORT: Scalingo nimmt den EXPOSE-Port aus Dockerfile.scalingo (3001).
# Lokal kannst du den Wert anpassen falls 3001 belegt ist.
# ============================================================
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ============================================================
# LLM Provider Configuration
# ============================================================

# Adacor AI (Primary LLM)
ADACOR_AI_API_URL=https://api.adacor.ai/chat/privateai/v1
ADACOR_AI_API_KEY=your-adacor-api-key
ADACOR_AI_MODEL=mistral-3-24b-128k

# ============================================================
# Security & Encryption
# ============================================================

# Token Encryption (generate with: openssl rand -hex 32)
CONNECTION_ENCRYPTION_KEY=your-256-bit-hex-key-here

# Cookie-Session-Secret (>=32 Zeichen, generate with: openssl rand -hex 32)
# Pflicht in Production. Lokal optional — bei Aenderung werden alle Sessions
# invalid (User muessen sich neu einloggen).
SESSION_SECRET=your-256-bit-hex-key-here

# Markitdown-API fuer Doc-Konvertierung (PDF/DOCX/XLSX → Markdown).
# Default ist der Adacor-Endpoint. Whitelist erlaubt nur *.adacor.ai oder
# localhost (M13-SSRF-Schutz, zentral in services/documentConverter.ts).
MARKITDOWN_API_URL=https://api.adacor.ai/v1/documentMarkdown/

# Docling-Konverter (W8, optional): sobald gesetzt, routet der zentrale
# Konverter Office-Formate und PDFs MIT Textlayer hierhin (bessere
# Tabellenstruktur); Scans bleiben bei Markitdown/Vision. Erwarteter Vertrag
# wie documentMarkdown: PUT, multipart-Feld `document`, Bearer
# ADACOR_AI_API_KEY, Antwort = Markdown (Text oder {markdown|text|content}).
# Bei Fehlern faellt jeder Aufruf einzeln auf Markitdown zurueck.
# DOCLING_API_URL=https://api.adacor.ai/v1/docling/

# Document-Processing-Webhooks (Welle 5) blocken standardmaessig interne Ziele
# (localhost, private IPs, 169.254.169.254 Cloud-Metadaten) — SSRF-Schutz.
# Nur setzen, wenn der Webhook-Empfaenger BEWUSST intern liegt (z. B. Consumer
# im selben Cluster). '1'/'true' schaltet interne Ziele frei.
# WEBHOOK_ALLOW_INTERNAL=0

# ============================================================
# OAuth Integrations
# ============================================================

# Google OAuth (for Google Drive connection)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Confluence/Atlassian OAuth
# Create an OAuth 2.0 app at https://developer.atlassian.com/console/myapps/
CONFLUENCE_CLIENT_ID=your-atlassian-app-client-id
CONFLUENCE_CLIENT_SECRET=your-atlassian-app-client-secret

# Jira OAuth (gleicher Atlassian-OAuth-Pool wie Confluence, separate Permissions)
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret

# Pipedrive OAuth (Sales-CRM)
# https://developers.pipedrive.com/docs/api/v1/getting-started
PIPEDRIVE_CLIENT_ID=your-pipedrive-client-id
PIPEDRIVE_CLIENT_SECRET=your-pipedrive-client-secret

# YouTrack (JetBrains) OAuth
# YOUTRACK_URL ist die Instanz-URL (https://example.youtrack.cloud)
YOUTRACK_URL=https://your-instance.youtrack.cloud
YOUTRACK_CLIENT_ID=your-youtrack-client-id

# DocuWare OAuth (DMS)
# DOCUWARE_ORG_URL ist die Mandant-URL (https://yourorg.docuware.cloud)
DOCUWARE_ORG_URL=https://your-org.docuware.cloud
DOCUWARE_CLIENT_ID=your-docuware-client-id
DOCUWARE_CLIENT_SECRET=your-docuware-client-secret

# ============================================================
# Optional: Image Generation
# ============================================================

# Google AI (Gemini Imagen) - for text-to-image and image-to-image
# Get API key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Nebius (Flux.1) - alternative image generation provider
NEBIUS_API_KEY=your-nebius-api-key

# fal.ai (Nano Banana Pro / Gemini Imagen) - alternative image provider
# Get API key at https://fal.ai/dashboard/keys
FAL_AI_API_KEY=your-fal-api-key

# ============================================================
# Optional: Web Search
# ============================================================

# Tavily API - for web search tool
# Get API key at https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key

# Brave Search API - alternative web search via Custom-Tool
# Get API key at https://brave.com/search/api/
# Wird vom Custom-Tool data/tools/custom/brave-search.json verwendet
# (envVar: BRAVE_API_KEY). Optional — wenn nicht gesetzt ist das Tool
# automatisch deaktiviert.
BRAVE_API_KEY=your-brave-api-key

# ============================================================
# Security Settings
# ============================================================

# SSRF Protection (Custom API Tools)
# Enable URLhaus malware domain checking (optional, makes external API call)
SSRF_CHECK_MALWARE=false
# Allow localhost in development (NOT recommended for production)
SSRF_ALLOW_LOCALHOST=false

# Proxy Configuration
# Set to true when running behind a reverse proxy (nginx, Cloudflare, etc.)
# This enables trusting X-Forwarded-For and X-Real-IP headers for client IP detection
# WARNING: Only enable this if you have a trusted proxy that sets these headers correctly
TRUST_PROXY=false

# ============================================================
# Platform-Locked Models (Provider-locked at deployment time)
# These models are used by platform features and cannot be
# changed by customers (admin or user)
# ============================================================

# Apps - Default model for chatbots and assistants
PLATFORM_APPS_PROVIDER_ID=adacor
PLATFORM_APPS_MODEL_ID=mistral-3-24b-128k

# Web Search - Model for search and research features
PLATFORM_SEARCH_PROVIDER_ID=adacor
PLATFORM_SEARCH_MODEL_ID=mistral-3-24b-128k

# Embeddings - Model for RAG and vector search
PLATFORM_EMBEDDINGS_PROVIDER_ID=adacor-embeddings
PLATFORM_EMBEDDINGS_MODEL_ID=multilingual-e5-large

# Reranking (optional) - Model for search result reranking
# PLATFORM_RERANK_PROVIDER_ID=adacor
# PLATFORM_RERANK_MODEL_ID=bge-reranker-v2-m3

# ============================================================
# Agent-Loop: Iterations-Budgets (= LLM-Zuege, ~1 Tool-Aufruf/Zug)
# Runaway-/Kosten-Notbremse, KEINE Normalbetriebs-Decke. Leer/0 -> Default.
# Ein Agent kann sein Budget zusaetzlich per config-Frontmatter (maxIterations)
# ueberschreiben.
# ============================================================
# AGENT_MAX_ITERATIONS=12            # direkter Agent (Default 12)
# AGENT_MAX_DELEGATED_ITERATIONS=20  # delegierter Sub-Agent (Default 20)
# AGENT_MAX_SUPERVISOR_ITERATIONS=25 # Supervisor-Orchestrierung (Default 25)

# ============================================================
# System Agent Models
# Fixed models for system agents (cannot be overridden by user)
# Leave empty to use system default from providers.yaml
# ============================================================

# Vision Agent - Must support vision capability
SYSTEM_VISION_PROVIDER_ID=adacor
SYSTEM_VISION_MODEL_ID=mistral-3-24b-128k

# Code Agent - For code generation and analysis
SYSTEM_CODE_PROVIDER_ID=adacor
SYSTEM_CODE_MODEL_ID=mistral-3-24b-128k

# Research Agent - For web research tasks
SYSTEM_RESEARCH_PROVIDER_ID=adacor
SYSTEM_RESEARCH_MODEL_ID=mistral-3-24b-128k

# Supervisor Agent - Must support tool_use for delegation
SYSTEM_SUPERVISOR_PROVIDER_ID=adacor
SYSTEM_SUPERVISOR_MODEL_ID=mistral-3-24b-128k

# ============================================================
# Customer-PoC-Konfiguration
# Pro Railway-Service / Customer-Environment individuell setzen.
# Alle drei optional — Default ist die unbeschraenkte Demo-Plattform.
# ============================================================

# App-Whitelist: nur die hier gelisteten App-IDs sind aktiv.
# Format: kommagetrennte Liste der App-IDs.
# Wenn nicht gesetzt: alle Built-In-Apps verfuegbar (Demo-Mode).
# ENABLED_APPS=wzbar-matcher,kunde-x-app

# Branding (Title + Logo) fuer Login, Sidebar und Browser-Tab.
# PLATFORM_TITLE=Workplace
# PLATFORM_LOGO_URL=https://cdn.example.com/kunde-x/logo.svg
# PLATFORM_LOGIN_SUBTITLE=PoC fuer Kunde X

# ============================================================
# Storage (Phase 1 — Foundation)
# Pflicht beim Scalingo-Deploy; lokal optional fuer Dev ohne DB/S3.
# ============================================================

# Scalingo Postgres (Addon)
# SCALINGO_POSTGRES=postgres://user:pass@host:port/dbname?sslmode=prefer

# Flow.swiss Object Storage (S3-kompatibel, Schweiz)
# FLOW_S3_ENDPOINT=https://os.alp1.flow.swiss
# FLOW_S3_MASTER=<access-key>
# FLOW_S3_SECRET=<secret-key>
# FLOW_S3_BUCKET=workplace-poc-demo

# ============================================================
# Deployment-Modes & Operations (Production/Scalingo)
# Lokal in der Regel ungesetzt lassen — die Defaults sind sicher.
# ============================================================

# Demo-Inhalte (User demo1..4, marketing1..3, ruhrpm, andreas_bachmann +
# Beispiel-Projekte/Chats/KB) idempotent beim Boot seeden.
# - false (Default): Customer-Modus, Admin legt sich beim ersten Login an
# - true: Demo-Modus, ueber Provider-Konsole/Scalingo-ENV setzen
# SEED_DEMO_DATA=false

# Pflicht-Override fuer Demo-Instanzen die in NODE_ENV=production laufen.
# Mein H9-Guard blockt SEED_DEMO_DATA=true im Production-Mode (verhindert
# versehentliches Seeden bekannter Demo-Passwoerter in echten Customer-
# Deployments). Wenn ihr eine *bewusste* Demo-Instanz aufsetzt:
#   ALLOW_DEMO_SEED_IN_PRODUCTION=true zusaetzlich zu SEED_DEMO_DATA=true.
# ALLOW_DEMO_SEED_IN_PRODUCTION=false

# Demo-Passwoerter (nur wirksam wenn SEED_DEMO_DATA=true).
# Pro PoC-Customer eigene Werte setzen, nicht die Defaults stehen lassen.
# DEMO_PASSWORD=Demo2026!
# MARKETING_PASSWORD=Marketing2026!

# Audit-Log-Retention auf Disk (data/audit/audit_*.jsonl) in Tagen.
# Default 90. 0 = Disk-Cleanup deaktiviert.
# Hinweis: Scalingo-Container haben keinen persistenten Disk — die echten
# Audit-Logs kommen ueber stdout (Marker [AUDIT]) im Scalingo-Log-Aggregator
# bzw. einem konfigurierten Log-Drain (Datadog/Logtail/Syslog).
# AUDIT_RETENTION_DAYS=90

# Recovery-Script (scripts/create-admin.ts) ohne TTY in Production erlauben.
# Default ist Pflicht-TTY: Recovery muss interaktiv ueber 'scalingo run'
# gestartet werden. Setze auf true nur wenn ein Scheduler/CI das Script
# bewusst triggern soll.
# ALLOW_RECOVERY_SCRIPT=false
