{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "mcp-server": "bun run src/mcp/server/index.ts",
    "db:generate": "cd .. && drizzle-kit generate",
