    "db:studio": "cd .. && drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pdfmake": "^0.3.1",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "docx": "^9.4.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.11.7",
    "pdfmake": "^0.2.18",
    "postgres": "^3.4.9",
    "yaml": "^2.8.2"
  }
