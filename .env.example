# KI-Workplace Configuration
# Single source of truth for all environment variables (Local Dev).
# Docker: env_file in docker-compose.yml | K8s: Secrets + ConfigMaps

# ============================================================
# Frontend (optional — nur VITE_-Prefix wird von Vite exponiert)
# Im Normalfall nicht nötig (Vite-Proxy und Nginx decken /api ab)
# ============================================================
FRONTEND_PORT=5173
# VITE_API_URL=/api

# ============================================================
# Backend Configuration
# ============================================================

# Server
BACKEND_PORT=3001
API_BASE_URL=http://localhost:3001
# NODE_ENV controls dev/prod behavior (CSRF localhost bypass, security headers, etc.)
# NODE_ENV=production
# Data directory (default: ./data relative to backend CWD)
# DATA_DIR=./data
# Maximum request body size in MB (default: 10)
MAX_BODY_SIZE_MB=10
# Maximum file upload size in MB (default: 50)
MAX_UPLOAD_SIZE_MB=50
# Temp directory for transient files like audio conversion (default: system TMPDIR or /tmp)
# TMPDIR=/tmp

# FRONTEND_URL — Optional. Nur nötig wenn Frontend auf einem anderen Origin läuft
# (d.h. ohne Vite Proxy / ohne K8s Ingress / ohne Reverse Proxy).
# Wenn nicht gesetzt, werden nur Same-Origin-Requests erlaubt (CORS).
# FRONTEND_URL=http://localhost:5173

# ============================================================
# LLM Provider Configuration
# ============================================================

# Adacor AI — Base domain (all paths are relative to this)
ADACOR_AI_API_BASE=https://api.adacor.ai
ADACOR_AI_API_KEY=your-adacor-api-key
ADACOR_AI_MODEL=mistral-3-24b-128k

# Default API path (fallback when no provider is configured yet)
ADACOR_AI_API_PATH=/chat/privateai/v1

# Model Sync (auto-sync models from API)
ADACOR_AI_MODELS_PATH=/chat/privateai/v1/models
# Custom headers for models endpoint (semicolon-separated, format: "Name: Value; Name2: Value2")
ADACOR_AI_MODELS_HEADERS=X-Api-Info: your-api-info-value

# Feature-based URL Routing (featureSet bitcode → full endpoint paths)
# {model} is replaced at runtime with the model ID
# Multiple paths per bit allowed. Bits: 1=Chat, 32=Embeddings, 64=Audio/Whisper, 128=Tokenize
ADACOR_AI_FEATURE_PATHS=1:/chat/privateai/{model}/v1/chat/completions;1:/completions/privateai/{model}/completions;2:/chat/privateai/{model}/v1/chat/completions;2:/completions/privateai/{model}/completions;32:/embeddings/privateai/{model}/v1/embeddings;64:/audio/whisper/{model}/v1/transcriptions;64:/audio/whisper/{model}/v1/translations;128:/chat/privateai/{model}/tokenize;128:/chat/privateai/{model}/detokenize

# Custom Provider/Model Management
# true = Admins können eigene Provider und Modelle hinzufügen/nutzen
# false = NUR Adacor-Modelle verfügbar, Custom-Provider komplett ausgeblendet
ALLOW_CUSTOM_PROVIDERS=true

# Document Conversion API (Markitdown - converts PDF/DOCX to Markdown)
# Used by: Knowledge Base indexing, chat attachments, contract management
# Built from: ADACOR_AI_API_BASE + MARKITDOWN_API_PATH (fallback: MARKITDOWN_API_URL)
MARKITDOWN_API_PATH=/v1/documentMarkdown/
# Legacy fallback (used when ADACOR_AI_API_BASE + MARKITDOWN_API_PATH not set)
# MARKITDOWN_API_URL=https://api.example.com/v1/documentMarkdown/

# ============================================================
# Security & Encryption
# ============================================================

# Token & API Key Encryption (generate with: openssl rand -hex 32)
# Used for: OAuth tokens, Provider API keys
CONNECTION_ENCRYPTION_KEY=

# ============================================================
# OAuth Integrations
# ============================================================
# OAuth-Credentials (Client ID/Secret) werden über die Admin-UI konfiguriert
# und verschlüsselt in data/plugins/configs/ gespeichert.
# Bestehende ENV-Variablen werden beim ersten Start automatisch migriert.

# ============================================================
# Optional: Image Generation
# ============================================================
# Custom Provider API Keys werden über die Admin-UI eingegeben und verschlüsselt gespeichert.

# ============================================================
# Optional: Web Search
# ============================================================

# Tavily API - for web search tool
# Get API key at https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key
# Alternative: generic web search API key (fallback if TAVILY_API_KEY not set)
# WEB_SEARCH_API_KEY=your-web-search-api-key

# Brave Search API - for brave_search custom tool
# Get API key at https://brave.com/search/api/ (Free: 2.000 Queries/Monat)
BRAVE_API_KEY=your-brave-api-key

# ============================================================
# Security Settings
# ============================================================

# SSRF Protection (Custom API Tools)
# Enable URLhaus malware domain checking (optional, makes external API call)
SSRF_CHECK_MALWARE=false
# Allow localhost in development (NOT recommended for production)
SSRF_ALLOW_LOCALHOST=false

# Additional allowed hostnames for OAuth callbacks (comma-separated)
# Use when OAuth providers need to redirect to a non-standard hostname
# ALLOWED_OAUTH_HOSTS=custom-domain.example.com

# Docs: Entwickler-Dokumentation im Menü anzeigen (default: true)
DOCS_DEVELOPER_ENABLED=true
# Docs: Partner-Dokumentation im Menü anzeigen (default: false)
# DOCS_PARTNER_ENABLED=true

# Debug: Include stack traces in error responses (development only)
# DEBUG_ERRORS=true

# MCP Runner (separate container for MCP server processes)
# When set, MCP servers are spawned in the Runner instead of as backend child processes
# MCP_RUNNER_URL=http://mcp-runner:3002
# MCP_RUNNER_SECRET=
# MCP_RUNNER_PORT=3002

# Proxy Configuration
# Set to true when running behind a reverse proxy (nginx, Cloudflare, etc.)
# This enables trusting X-Forwarded-For and X-Real-IP headers for client IP detection
# WARNING: Only enable this if you have a trusted proxy that sets these headers correctly
TRUST_PROXY=false

# Rate Limits (requests per window, defaults shown)
# RATE_LIMIT_AUTH=5          # Auth routes: per minute
# RATE_LIMIT_API=100         # Global API fallback: per minute
# RATE_LIMIT_UPLOAD=10       # Uploads/expensive ops: per minute
# RATE_LIMIT_SENSITIVE=3     # Password reset etc.: per 5 minutes
# RATE_LIMIT_IMAGE_GEN=5     # Image generation: per minute
# RATE_LIMIT_CHAT=30         # Chat/LLM requests: per minute

# ============================================================
# Platform-Locked Models (Provider-locked at deployment time)
# These models are used by platform features and cannot be
# changed by customers (admin or user)
# ============================================================

# Apps - Default model for chatbots and assistants
PLATFORM_APPS_PROVIDER_ID=adacor
PLATFORM_APPS_MODEL_ID=mistral-3-24b-128k

# Web Search - Model for search and research features
PLATFORM_SEARCH_PROVIDER_ID=adacor
PLATFORM_SEARCH_MODEL_ID=mistral-3-24b-128k

# Embeddings - Model for RAG and vector search
PLATFORM_EMBEDDINGS_PROVIDER_ID=adacor
PLATFORM_EMBEDDINGS_MODEL_ID=bge-m3

# Reranking (optional) - Model for search result reranking
# PLATFORM_RERANK_PROVIDER_ID=adacor
# PLATFORM_RERANK_MODEL_ID=bge-reranker-v2-m3

# ============================================================
# System Agent Models
# Fixed models for system agents (cannot be overridden by user)
# Leave empty to use system default from active.yaml
# ============================================================

# Vision Agent - Must support vision capability
SYSTEM_VISION_PROVIDER_ID=adacor
SYSTEM_VISION_MODEL_ID=mistral-3-24b-128k

# Code Agent - For code generation and analysis
SYSTEM_CODE_PROVIDER_ID=adacor
SYSTEM_CODE_MODEL_ID=mistral-3-24b-128k

# Research Agent - For web research tasks
SYSTEM_RESEARCH_PROVIDER_ID=adacor
SYSTEM_RESEARCH_MODEL_ID=mistral-3-24b-128k

# Supervisor Agent - Must support tool_use for delegation
SYSTEM_SUPERVISOR_PROVIDER_ID=adacor
SYSTEM_SUPERVISOR_MODEL_ID=mistral-3-24b-128k
