{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/security-review.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Wurden sicherheitskritische Dateien geändert (backend/src/routes/*, backend/src/middleware/*, backend/src/auth/*, backend/src/rbac/*, data/auth/*, data/connections/*)? Falls ja: {\"ok\": false, \"reason\": \"Security Review empfohlen\"}. Falls nein oder nur UI/Styling: {\"ok\": true}"
          }
        ]
      }
    ]
  }
}
